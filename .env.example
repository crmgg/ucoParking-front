# Debe coincidir con el "Identifier" del API creado en Auth0.
# VITE_AUTH0_AUDIENCE=https://api.tu-dominio.com/

# Backend UCO Parking (sin barra final suele ser más flexible con rutas axios)
VITE_API_BASE_URL=http://localhost:8080
